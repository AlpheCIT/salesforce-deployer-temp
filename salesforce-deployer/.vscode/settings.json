
{
    "python.linting.enabled": true,
    "python.linting.pylintEnabled": true,
    "python.linting.flake8Enabled": true,
    "python.linting.mypyEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.nosetestsEnabled": false,
    "python.testing.pytestArgs": [
        "tests"
    ],
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit"
    },
    "python.formatting.provider": "black",
    "python.formatting.blackArgs": [
        "--line-length=100"
    ],
    "[python]": {
        "editor.rulers": [100]
    },
    // Pre-commit hooks integration
    "git.enableCommitSigning": true,
    // API Contract development
    "yaml.schemas": {
        "https://raw.githubusercontent.com/OAI/OpenAPI-Specification/main/schemas/v3.0/schema.json": [
            "**/api-specs/*.yaml",
            "**/api-specs/*.yml"
        ]
    },
    // Recommended extensions
    "extensions.recommendations": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "redhat.vscode-yaml",
        "42crunch.vscode-openapi",
        "streetsidesoftware.code-spell-checker",
        "eamodio.gitlens",
        "ryanluker.vscode-coverage-gutters",
        "ms-vscode.test-adapter-converter",
        "njpwerner.autodocstring"
    ],
    // Mock server configuration
    "rest-client.environmentVariables": {
        "local": {
            "baseUrl": "http://localhost:8000"
        },
        "mock": {
            "baseUrl": "http://localhost:8001"
        }
    },
    // Shift-Left TDD settings
    "python.testing.autoTestDiscoverOnSaveEnabled": true,
    "python.testing.pytestEnabled": true,
    "coverage-gutters.showLineCoverage": true,
    "coverage-gutters.showRulerCoverage": true,
    "coverage-gutters.showGutterCoverage": true,
    "workbench.colorCustomizations": {
        "editorRuler.foreground": "#424242"
    },
    // Contract testing support
    "yaml.validate": true,
    "yaml.format.enable": true,
    // Component-driven development
    "html.format.wrapLineLength": 100,
    "javascript.updateImportsOnFileMove.enabled": "always",
    // Feature flag support
    "settings.cycle": [
        {
            "id": "featureFlags",
            "values": [
                {
                    "enableNewComparison": true,
                    "enableSelfHealing": true,
                    "enableBulkOperations": false
                },
                {
                    "enableNewComparison": true,
                    "enableSelfHealing": true, 
                    "enableBulkOperations": true
                },
                {
                    "enableNewComparison": false,
                    "enableSelfHealing": false,
                    "enableBulkOperations": false
                }
            ]
        }
    ],
    // Documentation generation
    "autoDocstring.docstringFormat": "google",
    "autoDocstring.generateDocstringOnEnter": true,
    // Project task definitions
    "task.quickOpen.detail": true,
    "task.quickOpen.skip": false,
    // API mocking integration
    "rest-client.previewOption": "exchange",
    "rest-client.previewResponseInUntitledDocument": true,
    // Type checking
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.diagnosticMode": "workspace",
    // Enforce code quality from the start
    "editor.codeLens": true,
    "diffEditor.codeLens": true,
    "python.linting.maxNumberOfProblems": 500
}