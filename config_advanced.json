      "SecurityValueCaptureTool": {
        "position": "Case_Detail",
        "fields": [
          "Case.Security_Value_Category__c",
          "Case.Security_Value_Amount__c",
          "Case.Value_Calculation_Method__c",
          "Case.CVSS_Score__c",
          "Case.Number_of_Affected_Assets__c"
        ]
      },
      "VulnerabilityContext": {
        "position": "Case_Detail",
        "fields": [
          "Vulnerability__c.QID__c",
          "Vulnerability__c.CVE_ID__c",
          "Vulnerability__c.Title__c",
          "Vulnerability__c.CVSS_Score__c",
          "Vulnerability__c.Severity__c",
          "Vulnerability__c.Patch_Available__c",
          "Vulnerability__c.Workaround_Available__c",
          "Vulnerability__c.False_Positive_Rate__c"
        ]
      },
      "AssetInventorySnapshot": {
        "position": "Bottom_Sidebar",
        "fields": [
          "Account.Total_Assets_Monitored__c",
          "Account.Total_Assets_By_Category__c",
          "Account.Average_Asset_Scan_Frequency__c"
        ]
      }
    },
    "macros": {
      "CalculateVulnerabilityImpactValue": {
        "description": "Calculate security value from vulnerability remediation",
        "actions": [
          {"type": "FieldUpdate", "field": "Security_Value_Category__c", "value": "Vulnerability Mitigation"},
          {"type": "FieldUpdate", "field": "Value_Calculation_Method__c", "value": "Risk Exposure Reduction"},
          {"type": "RunFormula", "target": "Security_Value_Amount__c", "formula": "Number_of_Affected_Assets__c * CVSS_Score__c * 1000"}
        ]
      },
      "IdentifySecurityExpansion": {
        "description": "Create security expansion opportunity from case",
        "actions": [
          {"type": "CreateRecord", "object": "Opportunity", "fields": {
            "Name": "{!Account.Name} - {!Product_Affected__c} Expansion",
            "AccountId": "{!AccountId}",
            "Type": "Add-On",
            "StageName": "Qualification",
            "CloseDate": "TODAY()+90",
            "Products_Of_Interest__c": "{!Product_Affected__c}",
            "Case_Originated__c": "true",
            "Originating_Case_ID__c": "{!CaseId}",
            "Security_Challenge_Addressed__c": "Vulnerability Management"
          }},
          {"type": "FieldUpdate", "field": "Expansion_Opportunity__c", "value": "{!OpportunityId}"}
        ]
      },
      "CompleteComplianceValue": {
        "description": "Calculate value from compliance maintenance",
        "actions": [
          {"type": "FieldUpdate", "field": "Security_Value_Category__c", "value": "Compliance Achievement"},
          {"type": "FieldUpdate", "field": "Value_Calculation_Method__c", "value": "Standard Qualys Formula"},
          {"type": "RunFormula", "target": "Security_Value_Amount__c", "formula": "IF(CONTAINS(Compliance_Frameworks_Affected__c, 'PCI DSS'), 25000, IF(CONTAINS(Compliance_Frameworks_Affected__c, 'HIPAA'), 30000, 15000))"}
        ]
      },
      "AttachVulnerabilityDetails": {
        "description": "Lookup and attach vulnerability details to case",
        "actions": [
          {"type": "QueryRecord", "object": "Vulnerability__c", "condition": "QID__c = '{!Case.QID__c}'"},
          {"type": "FieldUpdate", "field": "CVSS_Score__c", "value": "{!Vulnerability__c.CVSS_Score__c}"},
          {"type": "FieldUpdate", "field": "Severity__c", "value": "{!Vulnerability__c.Severity__c}"}
        ]
      }
    }
  },
  "lightningFlows": {
    "SecurityValueAssessment": {
      "description": "Guides agent through security value capture",
      "screens": [
        {
          "name": "SecurityValueIdentificationScreen",
          "fields": [
            "Security_Value_Category__c",
            "Value_Calculation_Method__c",
            "Number_of_Affected_Assets__c",
            "CVSS_Score__c"
          ]
        },
        {
          "name": "SecurityValueCalculationScreen",
          "fields": [
            "Security_Value_Amount__c"
          ],
          "calculatedFields": [
            {
              "field": "Security_Value_Amount__c",
              "formula": "IF(Value_Calculation_Method__c = 'Risk Exposure Reduction', Number_of_Affected_Assets__c * CVSS_Score__c * 1000, IF(Value_Calculation_Method__c = 'Customer MTTR Improvement', Number_of_Affected_Assets__c * 500, 0))"
            }
          ]
        },
        {
          "name": "SecurityExpansionScreen",
          "fields": [
            "Training_Need_Identified__c",
            "Product_Feedback_Captured__c"
          ]
        }
      ]
    },
    "CustomerSecurityContext": {
      "description": "Shows agent complete security context on case acceptance",
      "screens": [
        {
          "name": "AccountSecurityOverview",
          "fields": [
            "Account.Name", 
            "Account.Customer_Tier__c",
            "Account.Customer_Health_Score__c",
            "Account.Days_To_Renewal__c",
            "Account.TruRisk_Score__c",
            "Account.Vulnerability_Trend_30days__c"
          ]
        },
        {
          "name": "SecurityContactDetails",
          "fields": [
            "Contact.Name",
            "Contact.Security_Team_Role__c", 
            "Contact.Decision_Authority__c",
            "Contact.Technical_Expertise_Level__c",
            "Contact.Historical_Sentiment__c",
            "Contact.Qualys_Certification_Level__c"
          ]
        },
        {
          "name": "CustomerSecurityObjectives",
          "fields": [
            "Security_Objective__c.Objective_Category__c",
            "Security_Objective__c.Status__c", 
            "Security_Objective__c.Progress_Percentage__c",
            "Security_Objective__c.Current_Security_Posture__c"
          ]
        }
      ]
    },
    "VulnerabilityRemediation": {
      "description": "Guides agent through vulnerability remediation process",
      "screens": [
        {
          "name": "VulnerabilityIdentification",
          "fields": [
            "QID__c",
            "CVE_ID__c",
            "CVSS_Score__c"
          ]
        },
        {
          "name": "RemediationOptions",
          "fields": [
            "Patch_Deployment_Status__c",
            "Remediation_Step_Taken__c"
          ]
        },
        {
          "name": "ImpactAssessment",
          "fields": [
            "Number_of_Affected_Assets__c",
            "Compliance_Frameworks_Affected__c"
          ]
        }
      ]
    }
  },
  "integrations": {
    "QualysVMDR": {
      "direction": "Bidirectional",
      "objects": ["Case", "Security_Value_Metric__c", "Vulnerability__c"],
      "triggers": [
        {
          "event": "Critical Vulnerability Detected",
          "action": "Create Case",
          "mappings": {
            "Product_Affected__c": "VMDR",
            "Severity__c": "Vulnerability Severity",
            "QID__c": "Qualys QID",
            "Vulnerability_ID__c": "CVE ID",
            "Number_of_Affected_Assets__c": "Asset Count"
          }
        },
        {
          "event": "Case Resolved",
          "action": "Update Vulnerability Status in VMDR",
          "mappings": {
            "Resolution_Status": "Case.Status",
            "Resolution_Notes": "Case.Comments",
            "False_Positive": "Case.False_Positive_Dispute__c"
          }
        }
      ]
    },
    "QualysCloudAgent": {
      "direction": "Inbound",
      "objects": ["Case", "Account"],
      "triggers": [
        {
          "event": "Agent Offline Alert",
          "action": "Create Case",
          "mappings": {
            "Product_Affected__c": "Source Product",
            "Severity__c": "P2 - High",
            "Agent_Version__c": "Agent Version",
            "Last_Heartbeat_Timestamp__c": "Last Heartbeat"
          }
        }
      ]
    },
    "QualysSupportPhone": {
      "direction": "Inbound",
      "objects": ["Case", "Contact"],
      "triggers": [
        {
          "event": "Inbound Support Call",
          "action": "Screen Pop with Security Customer Context",
          "mappings": {
            "CallerID": "Contact.Phone",
            "DisplayFlow": "CustomerSecurityContext"
          }
        }
      ]
    },
    "QualysTruRiskAPI": {
      "direction": "Bidirectional",
      "objects": ["Account", "Security_Value_Metric__c"],
      "triggers": [
        {
          "event": "TruRisk Score Update",
          "action": "Update Account",
          "mappings": {
            "TruRisk_Score__c": "Current TruRisk Score",
            "Risk_Posture_Trend__c": "Risk Trend Direction"
          }
        }
      ]
    }
  },
