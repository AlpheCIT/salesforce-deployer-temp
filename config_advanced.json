        {"name": "Security_Team_Role__c", "type": "Picklist", "values": ["CISO", "IT Security Engineer", "DevSecOps", "Compliance Manager", "Security Analyst", "Vulnerability Manager", "IT Operations"]},
        {"name": "Product_Specialization__c", "type": "Multi-Picklist", "values": ["VMDR", "WAS", "Container Security", "Policy Compliance", "FIM", "IOC", "Patch Management", "Asset Management", "Threat Protection"]},
        {"name": "Decision_Authority__c", "type": "Picklist", "values": ["Decision Maker", "Influencer", "Technical Evaluator", "End User"]},
