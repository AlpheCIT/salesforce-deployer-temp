  "workflowRules": {
    "SLA_Escalation": {
      "description": "Escalate unresolved high-priority security cases",
      "criteria": "AND(Severity__c = 'P1 - Critical', Time_to_Resolution__c > 240)",
      "actions": [
        {"type": "FieldUpdate", "field": "Escalation_Reason__c", "value": "SLA Breach"},
        {"type": "Notify", "recipient": "Tier2_Support_Team"}
      ]
    },
    "Duplicate_Detection": {
      "description": "Prevent duplicate vulnerability cases",
      "criteria": "AND(Vulnerability_ID__c != '', ISBLANK(Duplicate_Case_ID__c))",
      "actions": [
        {"type": "FieldUpdate", "field": "Duplicate_Case_ID__c", "value": "Find duplicate case"},
        {"type": "Notify", "recipient": "Support_Agent"}
      ]
    },
    "Renewal_Risk_Alert": {
      "description": "Alert on accounts with negative sentiment approaching renewal",
      "criteria": "AND(Days_To_Renewal__c < 90, Customer_Health_Score__c < 60)",
      "actions": [
        {"type": "Task", "assignedTo": "Account_Manager__c", "subject": "Renewal Risk - Intervention Required"},
        {"type": "Notify", "recipient": "Qualys_Sales_Management"}
      ]
    },
    "Security_Expansion_Opportunity": {
      "description": "Create opportunity when support case reveals expansion potential",
      "criteria": "OR(Case.Training_Need_Identified__c = true, Case.Product_Feedback_Captured__c CONTAINS 'need additional', Case.CSAT_Score__c > 8)",
      "actions": [
        {"type": "CreateRecord", "object": "Opportunity", "fields": {
          "Type": "Add-On",
          "StageName": "Qualification",
          "Case_Originated__c": "true",
          "Originating_Case_ID__c": "Case.Id"
        }},
        {"type": "Notify", "recipient": "Account_Manager__c"}
      ]
    },
    "Security_Value_Metric_Creation": {
      "description": "Create security value metric record when case is resolved",
      "criteria": "AND(Case.Status = 'Closed', Case.Security_Value_Amount__c > 0)",
      "actions": [
        {"type": "CreateRecord", "object": "Security_Value_Metric__c", "fields": {
          "Account__c": "Case.AccountId",
          "Measurement_Date__c": "TODAY()",
          "Value_Type__c": "Case.Security_Value_Category__c",
          "Quantified_Value__c": "Case.Security_Value_Amount__c",
          "Source_Case__c": "Case.Id",
          "Qualys_Product__c": "Case.Product_Affected__c"
        }}
      ]
    },
    "Critical_Security_Context_Alert": {
      "description": "Display strategic security customer context on case creation",
      "criteria": "OR(Account.Customer_Tier__c = 'Strategic', Account.Customer_Tier__c = 'Enterprise', Case.Severity__c = 'P1 - Critical')",
      "actions": [
        {"type": "Alert", "message": "Strategic security customer: {!Account.Customer_Health_Score__c} health score, {!Account.Days_To_Renewal__c} days to renewal, {!Account.TruRisk_Score__c} TruRisk score, {!Account.Vulnerability_Trend_30days__c} vulnerability trend"},
        {"type": "FieldUpdate", "field": "Case.Priority", "value": "High"}
      ]
    },
    "Compliance_Critical_Issue": {
      "description": "Flag cases that could impact customer compliance status",
      "criteria": "Case.Compliance_Frameworks_Affected__c != NULL",
      "actions": [
        {"type": "FieldUpdate", "field": "Case.Priority", "value": "High"},
        {"type": "Notify", "recipient": "Compliance_Specialist_Team"}
      ]
    }
  },
  "dashboards": {
    "Executive_Vulnerability_Overview": {
      "widgets": [
        {"type": "Metric", "title": "Total Open Cases", "source": "COUNT(Case)"},
        {"type": "Chart", "title": "False Positive Rate by Product", "source": "COUNT(False_Positive_Dispute__c)"},
        {"type": "Chart", "title": "SLA Compliance %", "source": "AVG(Time_to_Resolution__c < SLA_Level__c)"},
        {"type": "Table", "title": "Top 10 Vulnerabilities Reported", "source": "GROUP BY Vulnerability_ID__c"}
      ]
    },
    "Security_Value_Dashboard": {
      "widgets": [
        {"type": "Metric", "title": "Total Security Value Generated", "source": "SUM(Security_Value_Metric__c.Quantified_Value__c)"},
        {"type": "Chart", "title": "Value by Qualys Product", "source": "SUM(Security_Value_Metric__c.Quantified_Value__c) GROUP BY Qualys_Product__c"},
        {"type": "Chart", "title": "Value by Account Tier", "source": "SUM(Security_Value_Metric__c.Quantified_Value__c) GROUP BY Account.Customer_Tier__c"},
        {"type": "Chart", "title": "MTTR Improvement by Product", "source": "AVG(Security_Value_Metric__c.Pre_Qualys_Remediation_Time__c - Security_Value_Metric__c.Post_Qualys_Remediation_Time__c) GROUP BY Qualys_Product__c"},
        {"type": "Table", "title": "Top Value-Generating Accounts", "source": "SUM(Security_Value_Metric__c.Quantified_Value__c) GROUP BY Account__c"}
      ]
    },
    "Support_Agent_Security_Performance": {
      "widgets": [
        {"type": "Metric", "title": "Average CSAT Score", "source": "AVG(Case.CSAT_Score__c)"},
        {"type": "Chart", "title": "Resolution Time by Agent", "source": "AVG(Case.Time_to_Resolution__c) GROUP BY Case.OwnerId"},
        {"type": "Chart", "title": "Security Value Generated by Agent", "source": "SUM(Case.Security_Value_Amount__c) GROUP BY Case.OwnerId"},
        {"type": "Chart", "title": "Security Expansion Opportunities Identified", "source": "COUNT(Opportunity.Case_Originated__c) GROUP BY Case.OwnerId"},
        {"type": "Table", "title": "Critical Vulnerabilities Remediated by Agent", "source": "COUNT(Case.Severity__c='P1 - Critical' AND Case.Status='Closed') GROUP BY Case.OwnerId"}
      ]
    },
    "TruRisk_Overview_Dashboard": {
      "widgets": [
        {"type": "Metric", "title": "Average Customer TruRisk Score", "source": "AVG(Account.TruRisk_Score__c)"},
        {"type": "Chart", "title": "TruRisk Score by Industry", "source": "AVG(Account.TruRisk_Score__c) GROUP BY Account.Industry"},
        {"type": "Chart", "title": "TruRisk Score Trend (6 months)", "source": "AVG(Account.TruRisk_Score__c) GROUP BY MONTH(TODAY())"},
        {"type": "Table", "title": "Accounts with Improving Risk Posture", "source": "FILTER Account WHERE Risk_Posture_Trend__c = 'Improving'"}
      ]
    }
  },
